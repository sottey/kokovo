# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Model and GPU. sdxl-turbo generally works best at 1-4 steps and CFG 0.
MODEL_ID=stabilityai/sdxl-turbo
DEVICE=cuda
TORCH_DTYPE=float16
HF_TOKEN=
ENABLE_CPU_OFFLOAD=false
ATTENTION_SLICING=true
XFORMERS_ENABLED=false
SAFETY_CHECKER_DISABLED=false
MODEL_CACHE_DIR=/app/models

# Generated files
OUTPUT_DIR=/app/outputs
SAVE_METADATA=true

# API protection. Leave API_KEY empty only on a trusted, isolated network.
API_KEY=change-me-before-exposing-this-service
REQUIRE_API_KEY=true

# Request limits
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
MAX_WIDTH=1536
MAX_HEIGHT=1536
MAX_STEPS=50
MAX_IMAGES=4
MAX_REFERENCE_IMAGE_BYTES=10485760
MAX_REFERENCE_IMAGE_PIXELS=20000000
